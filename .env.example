# Work Netlify site env vars (names only; set values in the Netlify UI, never commit them)
TURSO_DATABASE_URL=libsql://<db>-<org>.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=
# Per-device bearer tokens, comma separated, each optionally "label=token" (label goes in audit_log)
SILLY_WORK_API_TOKEN=
# Silly's enrolled public keys: JSON array of {device: phone|phone_unlock|chrome, spki: <base64 SPKI DER>, user_id, label}
SILLY_APPROVAL_KEYS=
# LMS triage carry (/api/carry)
TRIAGE_NOTIFY_TOKEN=
TRIAGE_NOTIFY_BASE=https://learn.farmfoods.co.uk
# Work-only ntfy push (/api/push): https endpoint, base64 of 32 bytes
WORK_NTFY_URL=
WORK_NTFY_KEY=
# Optional scrubber extras: comma lists
PII_NAME_DENYLIST=
PII_ALLOW_DOCS=
# Local only, used by scripts/extract-relay.mjs (one-time)
OLD_RELAY_TOKEN=
# Slice 3 PR B (names only; values go in the Netlify UI)
# Slack user token (xoxp-): scopes channels:history, groups:history, users:read, chat:write (files:write later, for the retail summary)
SLACK_USER_TOKEN=
# monday.com personal API token, used for reads only
MONDAY_API_TOKEN=
# Anthropic API key; daily caps per tier are optional (defaults 200 Haiku, 30 Sonnet)
ANTHROPIC_API_KEY=
WORK_HAIKU_DAILY_CAP=
WORK_SONNET_DAILY_CAP=
# Lets a scheduled function start a Netlify background function (the secret is a long random string)
SILLY_WORK_SITE_URL=https://silly-work.netlify.app
SILLY_WORK_TRIGGER_SECRET=
# Token labels allowed to send a saved Slack draft (default phone,chrome)
SLACK_SEND_ACTORS=
# Secret iCal addresses, comma or newline separated: the first is the main Work calendar, the second the Training team holidays
WORK_CAL_ICAL_URLS=
